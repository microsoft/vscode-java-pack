{
  "name": "vscode-java-pack",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "license": "MIT",
  "version": "0.31.2",
  "publisher": "vscjava",
  "preview": false,
  "engines": {
    "vscode": "^1.74.0"
  },
  "aiKey": "b4a8a622-6ac7-4cf8-83aa-f325e1890795",
  "icon": "logo.png",
  "keywords": [
    "java",
    "debugger",
    "junit",
    "maven",
    "spring"
  ],
  "categories": [
    "Programming Languages",
    "Linters",
    "Debuggers",
    "Formatters",
    "Snippets",
    "Extension Packs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Microsoft/vscode-java-pack"
  },
  "homepage": "https://github.com/Microsoft/vscode-java-pack",
  "bugs": {
    "url": "https://github.com/Microsoft/vscode-java-pack"
  },
  "main": "./out/extension",
  "l10n": "./l10n",
  "capabilities": {
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onLanguage:java",
    "workspaceContains:pom.xml",
    "workspaceContains:*/pom.xml",
    "workspaceContains:build.gradle",
    "workspaceContains:*/build.gradle",
    "workspaceContains:settings.gradle",
    "workspaceContains:*/settings.gradle",
    "workspaceContains:build.gradle.kts",
    "workspaceContains:*/build.gradle.kts",
    "workspaceContains:settings.gradle.kts",
    "workspaceContains:*/settings.gradle.kts",
    "workspaceContains:.classpath",
    "workspaceContains:*/.classpath",
    "onCommand:java.overview",
    "onCommand:java.showReleaseNotes",
    "onWebviewPanel:java.overview",
    "onCommand:java.runtime",
    "onCommand:java.gettingStarted",
    "onWebviewPanel:java.gettingStarted",
    "onCommand:java.extGuide",
    "onWebviewPanel:java.extGuide",
    "onCommand:java.welcome",
    "onWebviewPanel:java.welcome",
    "onCommand:java.installJdk",
    "onWebviewPanel:java.installJdk",
    "onCommand:java.classpathConfiguration",
    "onCommand:java.projectSettings",
    "onWebviewPanel:java.projectSettings",
    "onCommand:java.formatterSettings",
    "onWalkthrough:javaWelcome"
  ],
  "contributes": {
    "javaShortcuts": [
      {
        "title": "%shortcuts.projectSettings%",
        "command": "java.projectSettings"
      },
      {
        "title": "%shortcuts.helpCenter%",
        "command": "java.welcome"
      }
    ],
    "walkthroughs": [
      {
        "id": "javaWelcome",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "java.runtime",
            "title": "%walkthrough.java.runtime.title%",
            "description": "%walkthrough.java.runtime%",
            "media": {
              "markdown": "walkthrough/runtime.md"
            }
          },
          {
            "id": "java.showProjectExplorer",
            "title": "%walkthrough.java.projects.title%",
            "description": "%walkthrough.java.projects%",
            "media": {
              "svg": "walkthrough/projects.svg",
              "altText": "%walkthrough.java.projects.altText%"
            },
            "when": "java:projectManagerActivated && workspaceFolderCount > 0"
          },
          {
            "id": "java.showProjectExplorer.inactive",
            "title": "%walkthrough.java.projects.inactive.title%",
            "description": "%walkthrough.java.projects.inactive%",
            "media": {
              "svg": "walkthrough/projects.svg",
              "altText": "%walkthrough.java.projects.altText%"
            },
            "when": "!java:projectManagerActivated || workspaceFolderCount == 0"
          },
          {
            "id": "java.codeActions",
            "title": "%walkthrough.java.codeActions.title%",
            "description": "%walkthrough.java.codeActions%",
            "media": {
              "svg": "walkthrough/codeAction.svg",
              "altText": "%walkthrough.java.codeActions.altText%"
            }
          },
          {
            "id": "java.debugAndTest",
            "title": "%walkthrough.java.debugAndTest.title%",
            "description": "%walkthrough.java.debugAndTest%",
            "media": {
              "svg": "walkthrough/debugAndTest.svg",
              "altText": "%walkthrough.java.debugAndTest.altText%"
            }
          },
          {
            "id": "java.extensions",
            "title": "%walkthrough.java.extensions.title%",
            "description": "%walkthrough.java.extensions%",
            "media": {
              "svg": "walkthrough/extensions.svg",
              "altText": "%walkthrough.java.extensions.altText%"
            }
          },
          {
            "id": "java.more",
            "title": "%walkthrough.java.more.title%",
            "description": "%walkthrough.java.more%",
            "media": {
              "svg": "walkthrough/helpCenter.svg",
              "altText": "%walkthrough.java.more.altText%"
            },
            "when": "!isMac"
          },
          {
            "id": "java.moreForMac",
            "title": "%walkthrough.java.more.title%",
            "description": "%walkthrough.java.more%",
            "media": {
              "svg": "walkthrough/helpCenterMac.svg",
              "altText": "%walkthrough.java.more.altText%"
            },
            "when": "isMac"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "java.installJdk",
        "category": "Java",
        "title": "%commands.installJdk.title%"
      },
      {
        "command": "java.installJdk.fromWalkthrough",
        "category": "Java",
        "title": "%commands.installJdk.title%"
      },
      {
        "command": "java.welcome",
        "category": "Java",
        "title": "%commands.welcome.title%"
      },
      {
        "command": "java.welcome.fromWalkthrough",
        "category": "Java",
        "title": "%commands.welcome.title%"
      },
      {
        "command": "java.classpathConfiguration",
        "category": "Java",
        "title": "%commands.classpathConfiguration.title%"
      },
      {
        "command": "java.projectSettings",
        "category": "Java",
        "title": "%commands.projectSettings.title%"
      },
      {
        "command": "java.overview",
        "category": "Java",
        "title": "%commands.overview.title%"
      },
      {
        "command": "java.showReleaseNotes",
        "category": "Java",
        "title": "%commands.showReleaseNotes.title%"
      },
      {
        "command": "java.runtime",
        "title": "%commands.runtime.title%",
        "category": "Java"
      },
      {
        "command": "java.gettingStarted",
        "category": "Java",
        "title": "%commands.gettingStarted.title%"
      },
      {
        "command": "java.extGuide",
        "category": "Java",
        "title": "%commands.extGuide.title%"
      },
      {
        "command": "java.formatterSettings",
        "category": "Java",
        "title": "%commands.formatterSettings.title%"
      },
      {
        "command": "java.formatterSettings.showTextEditor",
        "category": "Java",
        "title": "%commands.formatterSettings.showTextEditor.title%",
        "icon": "$(go-to-file)"
      }
    ],
    "configuration": {
      "title": "%extension.displayName%",
      "properties": {
        "java.help.firstView": {
          "type": [
            "string"
          ],
          "enum": [
            "auto",
            "overview",
            "gettingStarted",
            "welcome",
            "none"
          ],
          "enumDescriptions": [
            "%configuration.firstView.auto%",
            "%configuration.firstView.overview%",
            "%configuration.firstView.gettingStarted%",
            "%configuration.firstView.welcome%",
            "%configuration.firstView.none%"
          ],
          "default": "auto",
          "description": "%configuration.firstView.description%",
          "scope": "window"
        },
        "java.help.showReleaseNotes": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.showReleaseNotes.description%",
          "scope": "window"
        },
        "java.help.collectErrorLog": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.collectErrorLog.description%",
          "scope": "window"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "java.formatterSettings.showTextEditor",
          "when": "false"
        },
        {
          "command": "java.welcome.fromWalkthrough",
          "when": "false"
        },
        {
          "command": "java.installJdk.fromWalkthrough",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "java.runtime",
          "group": "overflow_30@10",
          "when": "view == javaProjectExplorer"
        },
        {
          "command": "java.classpathConfiguration",
          "group": "overflow_30@20",
          "when": "view == javaProjectExplorer"
        }
      ],
      "view/item/context": [
        {
          "command": "java.classpathConfiguration",
          "group": "9_configuration@20",
          "when": "view == javaProjectExplorer && viewItem =~ /java:project(?=.*?\\b\\+unmanagedFolder\\b)(?=.*?\\b\\+uri\\b)/"
        }
      ],
      "editor/title": [
        {
          "command": "java.formatterSettings.showTextEditor",
          "when": "activeCustomEditorId == java.formatterSettingsEditor",
          "group": "navigation"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "java.formatterSettingsEditor",
        "displayName": "%customEditors.formatterSettings.displayName%",
        "selector": [
          {
            "filenamePattern": "*.xml"
          }
        ],
        "priority": "option"
      }
    ],
    "keybindings": [
      {
        "command": "java.welcome",
        "key": "shift+f1"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "webpack --config webpack.config.js",
    "watch": "webpack --config webpack.config.js --watch",
    "build": "webpack --config webpack.config.js --mode=\"production\"",
    "test": "node --test",
    "l10n:export": "vscode-l10n-dev export -o l10n src",
    "l10n:check": "node scripts/check-localization.js --check-extraction",
    "update-tpn": "node scripts/update-third-party-notice.js"
  },
  "devDependencies": {
    "@types/bytes": "^3.1.6",
    "@types/expand-tilde": "^2.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.25",
    "@types/node": "20.x",
    "@types/path-exists": "^4.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/semver": "^7.8.0",
    "@types/vscode": "^1.74.0",
    "@types/winreg": "^1.2.31",
    "@types/xmldom": "^0.1.31",
    "@vscode/l10n-dev": "^0.0.35",
    "autoprefixer": "^10.5.4",
    "bytes": "^3.1.2",
    "css-loader": "^7.1.5",
    "file-loader": "^6.2.0",
    "postcss": "^8.5.26",
    "postcss-loader": "^8.2.0",
    "process": "0.11.10",
    "sass": "^1.103.1",
    "sass-loader": "^17.0.1",
    "style-loader": "^3.3.1",
    "ts-loader": "^9.6.2",
    "tslint": "^6.1.3",
    "typescript": "^5.9.3",
    "webpack": "^5.110.2",
    "webpack-cli": "^7.2.3"
  },
  "extensionPack": [
    "redhat.java",
    "vscjava.vscode-java-debug",
    "vscjava.vscode-java-test",
    "vscjava.vscode-maven",
    "vscjava.vscode-gradle",
    "vscjava.vscode-java-dependency"
  ],
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@vscode-elements/elements": "^2.5.0",
    "@vscode/codicons": "^0.0.45",
    "@vscode/l10n": "^0.0.18",
    "@xmldom/xmldom": "^0.8.15",
    "axios": "^1.20.0",
    "bootstrap": "^5.3.8",
    "compare-versions": "^6.1.1",
    "expand-home-dir": "0.0.3",
    "expand-tilde": "^2.0.2",
    "fs-extra": "^11.4.0",
    "hdr-histogram-js": "^3.0.1",
    "highlight.js": "11.12.0",
    "jdk-utils": "^0.7.0",
    "jquery": "^4.0.0",
    "lodash": "^4.18.1",
    "react": "^19.0.0",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "semver": "^7.8.5",
    "vscode-extension-telemetry-wrapper": "^0.15.3",
    "vscode-tas-client": "^0.3.1"
  },
  "overrides": {
    "tas-client": "~0.2.33"
  }
}
